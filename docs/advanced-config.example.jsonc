{
  // 这是 Anima 绘图大师的“带注释高级配置模板”。
  // 真正生效的运行文件是：
  // data/config/astrbot_plugin_anima_master_config.json
  // 运行文件是标准 JSON，不能直接写注释；如需手动深度自定义，请对照本模板修改。

  // 打开并保存后，下次插件加载时恢复 schema 默认值；执行一次后会自动回到 false。
  "reset_to_defaults": false,

  // 千代预设：""（未启用）/ "base" / "aesthetic" / "turbo"。
  // 任一预设都会把对应的千代画师组写入 default_artist_tags，并把“狐莉”加入 fixed_characters。
  // aesthetic 另外覆盖 unet_name=anima_aestheticV11、cfg=3，且不注入质量词与负面词。
  // turbo 使用 Turbo LoRA 工作流、10 步、CFG 1、euler/simple 与低 CFG 提示词约束。
  "chiyo_preset": "",

  // AstrBot 能访问到的 ComfyUI 地址。
  "comfyui_base_url": "http://127.0.0.1:8188",

  // 当前内置工作流名称。不了解时保持默认。
  "workflow": "anima_t2i",

  // 普通版默认关闭自定义工作流。Turbo 变体配置见 variants/turbo/。
  "custom_workflow_enabled": false,
  "custom_workflow_path": "",

  // 单次生成总超时（秒）。ComfyUI 排队久时可适当调大。
  "timeout": 300,

  // 轮询 ComfyUI 状态的间隔（秒）。
  "poll_interval": 2,

  // 默认出图尺寸。
  "width": 1024,
  "height": 1536,

  // “竖图、宽屏”等比例快捷词的候选；明确宽x高需满足 512-1756 且为 4 的倍数，非白名单单次指定最多 1024x1024 像素。
  "allowed_sizes": [
    "832x1216",
    "896x1152",
    "1024x1024",
    "1152x896",
    "1216x832",
    "832x1472",
    "1472x832",
    "1024x1536"
  ],

  // 采样参数。
  "steps": 30,
  "cfg": 5.0,
  "sampler_name": "er_sde",
  "scheduler": "normal",

  // 使用自定义工作流时，默认保留工作流 JSON 内的采样参数。
  "custom_workflow_override_parameters": false,

  // 模型文件名。只填 ComfyUI 下拉框里显示的文件名，不填完整路径。
  "unet_name": "anima_baseV10.safetensors",
  "clip_name": "qwen_3_06b_base.safetensors",
  "vae_name": "qwen_image_vae.safetensors",

  // 固定拼接到正面提示词前后的默认词。
  "quality_prefix": "masterpiece, best quality, score_7, safe,",
  "negative_prompt": "worst quality, low quality, score_1, score_2, score_3, artist name",

  // 是否让聊天模型把中文需求整理成 Danbooru tags。
  "prompt_optimize_enabled": true,

  // 留空时使用当前聊天会话的主模型；填入后，专门用这个 Provider 来做提示词优化。
  "prompt_builder_provider_id": "",

  // LLM1 只抽取逐角色原文意图；本地匹配发生在其后。留空时使用插件内置系统提示词。
  "danbooru_semantic_system_prompt": "Extract only what the user said about each visible character. Copy phrases exactly, use null for unknown clothing, never guess tags or lore, and return JSON only.",

  // 提示词优化模型的输出控制。
  "prompt_builder_max_tokens": 1000,
  "prompt_builder_max_content_tags": 65,

  // 联网搜索：只会在用户明确触发相关关键词时进入。
  "prompt_builder_web_search_enabled": true,
  "prompt_builder_search_max_results": 5,
  "prompt_builder_search_depth": "advanced",
  "prompt_builder_search_query_template": "{prompt} 角色 外观 立绘 服装 配色 武器 官方图 official art character design outfit appearance wiki fandom",

  // 深度思考：只会在用户明确触发相关关键词时进入；如果模型不支持，会自动降级。
  "prompt_builder_deep_thinking_enabled": true,
  "prompt_builder_reasoning_effort": "high",

  // 旧的联网角色核心 tag 校正，默认关闭；本地语义校验不受影响。
  "danbooru_core_tag_lookup_enabled": false,
  // LLM 仅规划语义候选，本地 danbooru-tags 一次批量确认 hard tags。
  "danbooru_semantic_lookup_enabled": true,
  // 留空时读取 COMFYUI_GOOD_ANIMA_SKILLS_DIR 或 Codex 默认技能目录。
  "danbooru_local_cli_path": "",
  "danbooru_named_outfit_mappings": [
    "月之森校服=tsukinomori_school_uniform"
  ],
  "danbooru_term_mappings": [],
  "danbooru_tag_base_urls": "https://safebooru.donmai.us,https://danbooru.donmai.us",
  "danbooru_tag_user_agent": "AstrBotAnimaMaster/0.14",
  "danbooru_tag_lookup_timeout": 6.0,
  "danbooru_tag_max_candidates": 6,

  // 固定角色：格式为 “角色名=danbooru tags”。
  // 只有用户在聊天里明确提到角色名时才会使用。
  "fixed_characters": [],

  // 默认画师 / 画风 tags。用户说“不用我的风格 / 不要画师词”时会绕开。
  "default_artist_tags": "",

  // 画风 tags，会拼接在当前画师组之后。
  "style_tags": "",

  // 开启后，命中相关关键词时会让 LLM 自行写得更有边界表现力。
  "sensual_mode_enabled": true,
  "sensual_mode_markers": [
    "色气",
    "涩气",
    "擦边",
    "边界感",
    "性感",
    "诱惑",
    "魅惑",
    "妖艳",
    "撩人",
    "暧昧",
    "挑逗",
    "诱人",
    "透明",
    "透视",
    "黑纱",
    "薄纱",
    "蕾丝",
    "吊带",
    "紧身",
    "露肩",
    "绝对领域",
    "小恶魔",
    "suggestive",
    "seductive",
    "sexy",
    "sensual",
    "alluring",
    "see-through",
    "sheer",
    "transparent",
    "lace",
    "garter",
    "teasing"
  ],

  // 自定义关键词强制规则。命中用户原始文字后，会用高优先级语气要求 LLM 执行。
  // 每行格式：触发词1|触发词2 => 指令；多行可以同时命中。
  "keyword_prompt_rules_enabled": true,
  "keyword_prompt_rules": [
    "黑丝|丝袜 => 必须在 Tags 中明确加入 black pantyhose；不得用近义词替代"
  ],

  // 图生图仍属实验功能。当前更适合整图改图，不建议把它当稳定主线。
  "img2img_enabled": false,
  "prompt_optimize_img2img_enabled": false,
  "edit_denoise": 0.55,
  "max_image_side": 1024,

  // 改图会在上述最长边约束后，将宽高乘以此倍率写入“缩放图像”节点。
  "upscale_factor": 2.0,

  // 这些项当前主线不常用，但仍可手调。
  "remove_bg_model": "BiRefNet_lite",

  // 发送与权限。
  "send_result_to_chat": true,
  "max_send_images": 1,
  // 同时控制动态绘图进度提示，以及群聊完成后 At 申请人并告知今日剩余次数。
  "notify_drawing_and_at_sender": false,
  "admin_only": false,
  "allowed_sender_ids": [],
  // 每个 QQ 每天最多发起几次生图；0 表示不限。
  "daily_generation_limit": 0,
  // 免每日上限，也不受 allowed_sender_ids 限制；黑名单仍然优先。
  "generation_whitelist_sender_ids": [],
  // 命中后禁止使用整个插件。
  "generation_blacklist_sender_ids": [],

  // 由 AstrBot 启动 ComfyUI：不是开机自启，而是“收到绘图请求时，如果 ComfyUI 离线，再尝试启动”。
  // 仅对 AstrBot 所在机器生效。
  "auto_start": false,
  "startup_command": "",
  "startup_workdir": "",
  "startup_visible_window": true,
  "auto_start_admin_only": true,
  "auto_start_allowed_sender_ids": [],
  "startup_wait_seconds": 120,
  "startup_poll_interval": 3,

  // 某角色没有实际服装基础时：scene_adaptive / default_profile / creative_fallback。
  // scene_adaptive 把 default 作为软参考；强语境允许模型替换或补全，中性场景更倾向沿用。
  // 具体衣物/命名套组不调用 default；只有增删改但没给基础服装时，以 default 参考进行修改。
  "unspecified_wardrobe_policy": "scene_adaptive",
  "scene_adaptive_wardrobe_markers": ["刚刚出浴", "刚出浴", "洗完澡", "浴后", "刚起床", "准备睡觉", "运动结束后", "训练结束后", "比赛结束后", "比赛", "刚跑完步", "正在健身", "泳池边", "泳池旁", "在泳池", "游泳结束后", "演出结束后", "刚结束演出", "post-bath", "after a bath", "just woke up", "getting ready for bed", "after exercising", "after training", "after the competition", "just finished running", "working out", "poolside", "by the pool", "at the pool", "after swimming", "after performing"],

  // 主提示词模板。留空会使用插件内置模板，并自动获得后续安全规则更新。
  "prompt_builder_template": "",

  // 调试项默认关闭。只在排查问题时再开。
  "debug_prompt_enabled": false,
  "debug_image_reference_enabled": false,
  "debug_send_payload_enabled": false
}
